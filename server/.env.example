# Copy to .env and fill locally. Never commit the real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8787
HOST=127.0.0.1

# Optional limits
AI_TIMEOUT_MS=25000
AI_MAX_INPUT=12000
AI_MAX_OUTPUT_TOKENS=700
AI_RATE_PER_MIN=6
AI_RATE_PER_HOUR=30
AI_DAILY_LIMIT=200
AI_THINKING=disabled

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Agent model loop (optional). Key remains server-side.
AGENT_MODEL_TIMEOUT_MS=30000
AGENT_MAX_OUTPUT_TOKENS=6000
# Set exact hostname:port only if deploying beyond localhost. HTTPS/reverse proxy required for public deployment.
AGENT_PUBLIC_HOST=

# Optional planning-specific model limits. Defaults work without adding these to .env.
# AGENT_PLANNING_TIMEOUT_MS=90000
# AGENT_PLANNING_MAX_TOOL_CALLS=48
# AGENT_MODEL_MAX_ROUNDS=24

# Optional absolute path for durable single-process Agent state (keep on persistent local disk).
# AGENT_STATE_FILE=/absolute/private/path/agent-state.json

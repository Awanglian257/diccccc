diff --git a/tests/phase3-storage.test.cjs b/tests/phase3-storage.test.cjs
new file mode 100644
index 0000000..ba00562
--- /dev/null
+++ b/tests/phase3-storage.test.cjs
@@ -0,0 +1,7 @@
+'use strict';const {test}=require('node:test'),assert=require('node:assert/strict');
+function setup(){const S=require('../agent-storage.js');const data=new Map([['a','old-a'],['b','old-b']]);let fault=()=>false;const raw={getItem:k=>data.get(k)??null,setItem(k,v){if(fault(k,v))throw Error('disk full');data.set(k,v);},removeItem:k=>data.delete(k)};return {S,data,raw,setFault:f=>fault=f};}
+test('transaction verifies every write and rolls back partial failures',()=>{const x=setup(),s=x.S.create(x.raw);x.setFault(k=>k==='b');assert.throws(()=>s.transaction({a:'new-a',b:'new-b'}));assert.equal(s.read('a'),'old-a');assert.equal(s.read('b'),'old-b');});
+test('failed rollback keeps journal and consistent old read view until recovery',()=>{const x=setup(),s=x.S.create(x.raw);x.setFault((k,v)=>k==='b'||k==='a'&&v==='old-a');assert.throws(()=>s.transaction({a:'new-a',b:'new-b'}));assert.equal(s.read('a'),'old-a');assert(x.data.has(x.S.JOURNAL));x.setFault(()=>false);s.recover();assert.equal(x.raw.getItem('a'),'old-a');assert(!x.data.has(x.S.JOURNAL));});
+test('guard failure rolls back all keys; success preserves existing value formats',()=>{const x=setup(),s=x.S.create(x.raw);let n=0;assert.throws(()=>s.transaction({a:'[]',b:'{}'},{guard(){if(++n===3)throw Error('context changed');}}));assert.equal(s.read('a'),'old-a');s.transaction({a:'[]',b:'{}'});assert.equal(x.raw.getItem('a'),'[]');assert.equal(x.raw.getItem('b'),'{}');});
+test('prepared journal recovers old values and committed journal recovers new values',()=>{for(const state of ['prepared','committed']){const x=setup();x.raw.setItem(x.S.JOURNAL,JSON.stringify({version:1,state,changes:[{key:'a',before:'old-a',after:'new-a'}]}));x.S.create(x.raw).recover();assert.equal(x.raw.getItem('a'),state==='prepared'?'old-a':'new-a');}});
+test('silent dropped writes are detected, not acknowledged as success',()=>{const x=setup(),old=x.raw.setItem;x.raw.setItem=function(k,v){if(k!=='b')old.call(this,k,v);};const s=x.S.create(x.raw);assert.throws(()=>s.transaction({a:'new-a',b:'new-b'}));assert.equal(s.read('a'),'old-a');assert.equal(s.read('b'),'old-b');});
